# Copy to .env (git-ignored). `npm start` reads it with --env-file-if-exists.
PORT=11010
# Where every store writes (FsStore files, audit and event logs, accelerator data).
DATA_DIR=.application
# The URL people reach the app on (tracking links, redirects).
PUBLIC_URL=http://localhost:11010
# development | test | production. Production needs SESSION_SECRET and has no development sign-in.
NODE_ENV=development
# Signs the session cookie. Required in production (any long random string).
SESSION_SECRET=
# 0 turns off /dev/login, the X-Dev-Person header and the development people outside production.
DEV_SIGN_IN=
# GitHub OAuth app for "Continue with GitHub" (callback: <PUBLIC_URL>/auth/github/callback). Empty outside production:
# the mock GitHub at /dev/github is used instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# How people sign in and get an account (AUTH_TYPE; the older AUTHTYPE also works):
#   (unset) anyone signs up on the form at /, with email and password or GitHub.
#   local   by invitation only: core's "Create New Account" goes to its register screen; the sign-up form and GitHub
#           make an account only for an open invitation to that email; people with an account sign in as before.
#   google  Google is the only way in (core's sign-in page goes straight to Google; email sign-up and GitHub sign-in
#           are off; the password form stays for operators at /services/authservice/views/login.html?local=1).
# Register <PUBLIC_URL>/services/authservice/api/google/callback as the OAuth client's authorised redirect URI.
# Without a client outside production, a mock Google at /dev/google stands in.
AUTH_TYPE=
# Where Google sends the browser back, when it is not PUBLIC_URL (Codespaces: https://<codespace>-11010.app.github.dev).
# The app logs the full redirect URI to register when it starts.
GOOGLE_REDIRECT_BASE=
GOOGLE_OAUTH_CLIENT=
GOOGLE_OAUTH_SECRET=
# Production providers (docs/production.md): records in MongoDB, sessions in Redis. Files and memory otherwise.
MONGODB_URL=
MONGODB_DATABASE=nooblyjs_cloud
REDIS_URL=
# Encrypts environment variables and GitHub tokens (required in production).
HERO_SECRET_KEY=
# Signs hosted invoice and payment links (required in production, 16+ characters).
PAY_SIGNING_SECRET=
# Set to 1 behind a proxy or load balancer.
TRUST_PROXY=
# The domain service URLs are made on (<service>.APP_DOMAIN), from Phase 2.
APP_DOMAIN=nooblyjs.app
# Customers accelerator: signs tracking and unsubscribe links. Without it, links stop working after a restart.
CX_TRACKING_SECRET=
# nooblyjs-core settings encryption, and the infrastructure accelerator's secret store. Required before real values.
SETTINGS_SECRET=
INFRA_SECRET_KEY=
